# ==============================================
# La Donuts — environment variables
# ==============================================

# Payload / Next -------------------------------
# Postgres connection (required)
POSTGRES_URL=postgresql://buford:password@localhost:5432/ladonuts

# JWT encryption secret (required)
PAYLOAD_SECRET=

# Public site URL, no trailing slash (required)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Auto-run migrations on server start. Set "true" on VPS so deploys migrate themselves.
DATABASE_MIGRATE_ON_START=false

# Optional: cron + preview secrets
CRON_SECRET=
PREVIEW_SECRET=

# S3 / MinIO storage ---------------------------
# Local dev points at MinIO on VPS or local MinIO via docker-compose
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ladonuts-media
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Square ---------------------------------------
# Use sandbox values during dev, production values in prod
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=

# Client-safe (must be prefixed NEXT_PUBLIC_)
NEXT_PUBLIC_SQUARE_APPLICATION_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=
NEXT_PUBLIC_SQUARE_ENVIRONMENT=sandbox

# Email (Resend for order confirmations) ------
RESEND_API_KEY=
RESEND_FROM_EMAIL=orders@la-donuts.com
RESEND_OWNER_NOTIFY_EMAIL=
